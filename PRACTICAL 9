#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node* left;
    struct Node* right;
};

struct Node* createNode(int value) {
    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
    newNode->data = value;
    newNode->left = NULL;
    newNode->right = NULL;
    return newNode;
}

struct Node* insert(struct Node* root, int value) {
    if (root == NULL) {
        return createNode(value);
    }
    if (value < root->data) {
        root->left = insert(root->left, value);[cite: 4]
    } else if (value > root->data) {
        root->right = insert(root->right, value);[cite: 4]
    }
    return root;
}

void inorder(struct Node* root) {
    if (root != NULL) {
        inorder(root->left);[cite: 4]
        printf("%d ", root->data);[cite: 4]
        inorder(root->right);[cite: 4]
    }
}

int main() {
    struct Node* root = NULL;
    root = insert(root, 50);[cite: 4]
    insert(root, 30);[cite: 4]
